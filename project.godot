; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BrickForce AI"
config/version="0.1.0-alpha"
config/description="Tactical offline battle royale — human vs AI"
config/tags=["tactical","battle-royale","ai","squad"]
run/main_scene="res://scenes/autoloads/bootstrap.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/textures/icon.svg"

[autoload]

; ─── Core Infrastructure ───────────────────────────────────────────────────
EventBus="*res://src/core/events/event_bus.gd"
Logger="*res://src/core/logging/logger.gd"
ObjectPool="*res://src/core/pooling/object_pool.gd"
PerformanceMonitor="*res://src/core/performance/performance_monitor.gd"

; ─── Game Systems ───────────────────────────────────────────────────────────
GameManager="*res://src/core/managers/game_manager.gd"
SceneManager="*res://src/core/managers/scene_manager.gd"
SettingsManager="*res://src/core/managers/settings_manager.gd"
SaveManager="*res://src/save/save_manager.gd"
InputManager="*res://src/core/managers/input_manager.gd"
TimeManager="*res://src/core/managers/time_manager.gd"

; ─── Economy & Inventory ────────────────────────────────────────────────────
CurrencyManager="*res://src/economy/currency/currency_manager.gd"
InventoryManager="*res://src/economy/inventory/inventory_manager.gd"
ShopManager="*res://src/economy/shop/shop_manager.gd"
CosmeticManager="*res://src/economy/cosmetics/cosmetic_manager.gd"

; ─── Audio & VFX ────────────────────────────────────────────────────────────
AudioManager="*res://src/audio/audio_manager.gd"
VFXManager="*res://src/vfx/vfx_manager.gd"

; ─── Network Layer ──────────────────────────────────────────────────────────
NetworkManager="*res://src/network/network_manager.gd"
APIManager="*res://src/network/api/api_manager.gd"

; ─── Gameplay World Systems ─────────────────────────────────────────────────
CoverSystem="*res://src/gameplay/cover/cover_system.gd"
LootManager="*res://src/world/loot/loot_manager.gd"

; ─── Network ─────────────────────────────────────────────────────────────────
StateSync="*res://src/network/sync/state_sync.gd"

; ─── Match Systems ───────────────────────────────────────────────────────────
MatchScoring="*res://src/gameplay/match/match_scoring.gd"

; ─── Component Registry ──────────────────────────────────────────────────────
ComponentSystem="*res://src/core/systems/component_system.gd"

; ─── Debug / Dev Tools ──────────────────────────────────────────────────────
DebugConsole="*res://src/core/debug/debug_console.gd"
DevTools="*res://src/core/debug/dev_tools.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1
window/energy_saving/keep_screen_on=false

[editor]

movie_writer/fps=60

[filesystem]

import/blender/enabled=false

