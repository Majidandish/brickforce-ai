[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy"
3d_physics/layer_4="projectile"
3d_physics/layer_5="interactable"
3d_physics/layer_6="cover"
3d_physics/layer_7="zone"
3d_physics/layer_8="loot"
3d_physics/layer_9="trigger"
3d_physics/layer_10="vehicle"
3d_physics/layer_11="squad_member"
3d_physics/layer_12="destructible"

[network]

limits/debugger/max_queued_messages=2048

[physics]

3d/physics_engine="GodotPhysics3D"
3d/run_on_separate_thread=true
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=8

[rendering]

renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
scaling_3d/mode=0
scaling_3d/scale=1.0
lights_and_shadows/directional_shadow/size=4096
environment/defaults/default_environment="res://resources/config/default_environment.tres"
